# Server Configuration
PORT=5000

# MongoDB Configuration (Local instance)
MONGO_URI=mongodb://127.0.0.1:27017/GigHub

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# Firebase Admin SDK Configuration (Optional: path to serviceAccountKey.json)
# If left empty, Firebase features will gracefully run in simulated/dry-run mode without crashing
FIREBASE_SERVICE_ACCOUNT_PATH=

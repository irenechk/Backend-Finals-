{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-4a5b-8c9d-0e1f2a3b4c5d",
    "name": "GigHub API — Freelance Marketplace",
    "description": "Complete Postman collection for GigHub Backend (Case Study 27)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "clientToken", "value": "" },
    { "key": "freelancerToken", "value": "" },
    { "key": "gigId", "value": "" },
    { "key": "bidId", "value": "" },
    { "key": "milestoneId", "value": "" },
    { "key": "chatId", "value": "" },
    { "key": "disputeId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Client\",\n  \"email\": \"alice@client.com\",\n  \"password\": \"Password123\",\n  \"role\": \"client\",\n  \"bio\": \"Tech startup director\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Register Freelancer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Freelancer\",\n  \"email\": \"bob@freelance.local\",\n  \"password\": \"Password123\",\n  \"role\": \"freelancer\",\n  \"bio\": \"Full-Stack Engineer\",\n  \"skills\": [\"Node.js\", \"Express\", \"MongoDB\", \"Socket.io\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login Client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@client.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login Freelancer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bob@freelance.local\",\n  \"password\": \"Password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. Gigs",
      "item": [
        {
          "name": "Create Gig (Client)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Build MERN Marketplace Backend\",\n  \"description\": \"Need an Express/MongoDB backend with JWT, Socket.io, and Escrow.\",\n  \"budget\": 1200,\n  \"category\": \"Backend\",\n  \"skills\": [\"Node.js\", \"MongoDB\", \"Socket.io\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/gigs", "host": ["{{baseUrl}}"], "path": ["gigs"] }
          }
        },
        {
          "name": "Browse Gigs (Filter & Search)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/gigs?status=open&search=Marketplace", "host": ["{{baseUrl}}"], "path": ["gigs"], "query": [{ "key": "status", "value": "open" }, { "key": "search", "value": "Marketplace" }] }
          }
        },
        {
          "name": "Get Gig by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/gigs/{{gigId}}", "host": ["{{baseUrl}}"], "path": ["gigs", "{{gigId}}"] }
          }
        },
        {
          "name": "Update Gig (Owner)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"budget\": 1400\n}"
            },
            "url": { "raw": "{{baseUrl}}/gigs/{{gigId}}", "host": ["{{baseUrl}}"], "path": ["gigs", "{{gigId}}"] }
          }
        }
      ]
    },
    {
      "name": "3. Bids",
      "item": [
        {
          "name": "Submit Bid (Freelancer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{freelancerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gig\": \"{{gigId}}\",\n  \"amount\": 1150,\n  \"proposal\": \"I have built multiple marketplace backends with Mongoose and Socket.io.\",\n  \"deliveryTime\": 10\n}"
            },
            "url": { "raw": "{{baseUrl}}/bids", "host": ["{{baseUrl}}"], "path": ["bids"] }
          }
        },
        {
          "name": "Get Bids for Gig",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": { "raw": "{{baseUrl}}/bids?gig={{gigId}}", "host": ["{{baseUrl}}"], "path": ["bids"], "query": [{ "key": "gig", "value": "{{gigId}}" }] }
          }
        },
        {
          "name": "Accept Bid (Client)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"accepted\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/bids/{{bidId}}", "host": ["{{baseUrl}}"], "path": ["bids", "{{bidId}}"] }
          }
        }
      ]
    },
    {
      "name": "4. Milestones & Escrow",
      "item": [
        {
          "name": "Create Milestone",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gig\": \"{{gigId}}\",\n  \"freelancer\": \"{{freelancerId}}\",\n  \"title\": \"Phase 1: REST API & DB Schema\",\n  \"description\": \"Deliverable: All REST endpoints operational with unit tests.\",\n  \"amount\": 600\n}"
            },
            "url": { "raw": "{{baseUrl}}/milestones", "host": ["{{baseUrl}}"], "path": ["milestones"] }
          }
        },
        {
          "name": "Fund Escrow (Client)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": { "raw": "{{baseUrl}}/escrow/fund/{{milestoneId}}", "host": ["{{baseUrl}}"], "path": ["escrow", "fund", "{{milestoneId}}"] }
          }
        },
        {
          "name": "Submit Work (Freelancer)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{freelancerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"submitted\",\n  \"submissionNotes\": \"Code pushed to GitHub branch and ready for review.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/milestones/{{milestoneId}}", "host": ["{{baseUrl}}"], "path": ["milestones", "{{milestoneId}}"] }
          }
        },
        {
          "name": "Release Escrow Funds (Client)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": { "raw": "{{baseUrl}}/escrow/release/{{milestoneId}}", "host": ["{{baseUrl}}"], "path": ["escrow", "release", "{{milestoneId}}"] }
          }
        },
        {
          "name": "Check Escrow Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": { "raw": "{{baseUrl}}/escrow/status/{{milestoneId}}", "host": ["{{baseUrl}}"], "path": ["escrow", "status", "{{milestoneId}}"] }
          }
        }
      ]
    },
    {
      "name": "5. Chats",
      "item": [
        {
          "name": "Start or Get Conversation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientId\": \"{{freelancerId}}\",\n  \"gigId\": \"{{gigId}}\",\n  \"initialMessage\": \"Hello! Let us kick off the project milestone today.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/chats", "host": ["{{baseUrl}}"], "path": ["chats"] }
          }
        },
        {
          "name": "Get All My Chats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": { "raw": "{{baseUrl}}/chats", "host": ["{{baseUrl}}"], "path": ["chats"] }
          }
        },
        {
          "name": "Get Chat Messages History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": { "raw": "{{baseUrl}}/chats/{{chatId}}", "host": ["{{baseUrl}}"], "path": ["chats", "{{chatId}}"] }
          }
        },
        {
          "name": "Send Message (REST)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{freelancerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Sounds great! Working on the database models now.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/chats/{{chatId}}/messages", "host": ["{{baseUrl}}"], "path": ["chats", "{{chatId}}", "messages"] }
          }
        }
      ]
    },
    {
      "name": "6. Disputes",
      "item": [
        {
          "name": "Raise Dispute",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gig\": \"{{gigId}}\",\n  \"against\": \"{{freelancerId}}\",\n  \"reason\": \"Deliverable delayed without prior notice\",\n  \"description\": \"Expected delivery on Monday but still pending response.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/disputes", "host": ["{{baseUrl}}"], "path": ["disputes"] }
          }
        },
        {
          "name": "Get Disputes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": { "raw": "{{baseUrl}}/disputes", "host": ["{{baseUrl}}"], "path": ["disputes"] }
          }
        },
        {
          "name": "Resolve Dispute",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"resolved\",\n  \"resolution\": \"Extended deadline agreed by 3 days.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/disputes/{{disputeId}}", "host": ["{{baseUrl}}"], "path": ["disputes", "{{disputeId}}"] }
          }
        }
      ]
    },
    {
      "name": "7. Portfolio",
      "item": [
        {
          "name": "Get Freelancer Portfolio",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/portfolio/{{freelancerId}}", "host": ["{{baseUrl}}"], "path": ["portfolio", "{{freelancerId}}"] }
          }
        }
      ]
    }
  ]
}


